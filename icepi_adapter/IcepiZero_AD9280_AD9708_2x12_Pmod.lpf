# IcepiZero_AD9280_AD9708_2x12_Pmod
# HS-AD/DA V2.0 AD9280 ADC + AD9708 DAC, plus a Pmod
# GENERATED by make_boards.py from the same pin assignment as
# the PCB -- do not edit.  Rebuild with:
#     KICAD=10 ./kicad-python.sh make_boards.py

# ---- the converter module, through this adapter -------------
LOCATE COMP "ad0" SITE "R1";   # AD0, header pin 7 / GPIO4
IOBUF  PORT "ad0" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad1" SITE "R3";   # AD1, header pin 11 / GPIO17
IOBUF  PORT "ad1" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad2" SITE "N4";   # AD2, header pin 12 / GPIO18
IOBUF  PORT "ad2" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad3" SITE "P3";   # AD3, header pin 13 / GPIO27
IOBUF  PORT "ad3" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad4" SITE "P2";   # AD4, header pin 15 / GPIO22
IOBUF  PORT "ad4" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad5" SITE "M2";   # AD5, header pin 16 / GPIO23
IOBUF  PORT "ad5" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad6" SITE "L1";   # AD6, header pin 18 / GPIO24
IOBUF  PORT "ad6" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "ad7" SITE "L2";   # AD7, header pin 19 / GPIO10
IOBUF  PORT "ad7" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "aclk" SITE "J1";   # ACLK, header pin 21 / GPIO9
IOBUF  PORT "aclk" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "dclk" SITE "G2";   # DCLK, header pin 23 / GPIO11
IOBUF  PORT "dclk" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da7" SITE "H2";   # DA7, header pin 24 / GPIO8
IOBUF  PORT "da7" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da6" SITE "G1";   # DA6, header pin 26 / GPIO7
IOBUF  PORT "da6" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da5" SITE "E1";   # DA5, header pin 29 / GPIO5
IOBUF  PORT "da5" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da4" SITE "F3";   # DA4, header pin 31 / GPIO6
IOBUF  PORT "da4" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da3" SITE "J3";   # DA3, header pin 32 / GPIO12
IOBUF  PORT "da3" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da2" SITE "E3";   # DA2, header pin 33 / GPIO13
IOBUF  PORT "da2" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da1" SITE "E4";   # DA1, header pin 35 / GPIO19
IOBUF  PORT "da1" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "da0" SITE "D4";   # DA0, header pin 37 / GPIO26
IOBUF  PORT "da0" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;

# ---- the Pmod socket J3: pmod[n-1] is the Pmod standard's IOn (pins 1-4, 7-10) -----
LOCATE COMP "pmod[0]" SITE "N1";   # PMOD1, socket pad 1, header pin 10 / GPIO15
IOBUF  PORT "pmod[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[1]" SITE "G3";   # PMOD2, socket pad 3, header pin 27 / GPIO0
IOBUF  PORT "pmod[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[2]" SITE "H3";   # PMOD3, socket pad 5, header pin 36 / GPIO16
IOBUF  PORT "pmod[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[3]" SITE "F2";   # PMOD4, socket pad 7, header pin 40 / GPIO21
IOBUF  PORT "pmod[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[4]" SITE "P1";   # PMOD5, socket pad 2, header pin 8 / GPIO14
IOBUF  PORT "pmod[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[5]" SITE "J2";   # PMOD6, socket pad 4, header pin 22 / GPIO25
IOBUF  PORT "pmod[5]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[6]" SITE "K3";   # PMOD7, socket pad 6, header pin 28 / GPIO1
IOBUF  PORT "pmod[6]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "pmod[7]" SITE "F1";   # PMOD8, socket pad 8, header pin 38 / GPIO20
IOBUF  PORT "pmod[7]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 SLEWRATE=SLOW;

# ---- the Icepi Zero itself ----------------------------
LOCATE COMP "clk50" SITE "M1";   # 50 MHz oscillator -- the only clock on the board
IOBUF  PORT "clk50" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "uart_tx" SITE "K15";   # to U9 (FT231X) RXD -> /dev/ttyUSB* on the host
IOBUF  PORT "uart_tx" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "uart_rx" SITE "K16";   # from U9 (FT231X) TXD
IOBUF  PORT "uart_rx" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "led0" SITE "E13";
IOBUF  PORT "led0" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "led1" SITE "D14";
IOBUF  PORT "led1" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "led2" SITE "E12";
IOBUF  PORT "led2" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "led3" SITE "C13";
IOBUF  PORT "led3" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "led4" SITE "D13";
IOBUF  PORT "led4" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "btn0" SITE "C4";   # also the LiteX reset button
IOBUF  PORT "btn0" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "btn1" SITE "C5";
IOBUF  PORT "btn1" IO_TYPE=LVCMOS33 PULLMODE=UP;

# The oscillator, so nextpnr reports the real timing margin
# instead of guessing.
FREQUENCY PORT "clk50" 50 MHZ;
