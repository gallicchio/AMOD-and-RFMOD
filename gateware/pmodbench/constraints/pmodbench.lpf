# pmodbench's additions to the board's pin constraints (vendor/ecp5_2adc_2dac.lpf, read first).
# The Pmod pins have NO internal pull: a released pin is high-impedance, so the tile's own resistors decide
# (AMOD-N's 100 k pull-up on LE, RF-MOD's 100 k pull-down on LE, ...).  8 mA, slow edges into the 33 ohm
# series resistors.  Lattice's default for an LVCMOS input is a pull-down of 30-150 uA, which would beat
# a 100 k pull-up: hence the explicit NONE.
IOBUF PORT "pmoda[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[5]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[6]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmoda[7]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[5]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[6]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
IOBUF PORT "pmodb[7]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=8 SLEWRATE=SLOW;
