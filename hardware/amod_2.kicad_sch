	(text "The classic pulsed-NMR duplexer, broadband except for its one cable: crossed diodes in series with the transmitter, and a"
		(exclude_from_sim no)
		(at 27.94 141.94 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "f60871e2-ab58-50ce-bc0a-fbb1af7bfd3f")
	)
	(text "(a lossy tank coupled to a sharp one: the EIT analogue).  A pump at twice the frequency on TUNE / PUMP: parametric gain."
		(exclude_from_sim no)
		(at 27.94 403.86 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "f7fab0e3-1c91-5cd4-804b-4a91279f12cd")
	)
	(text "OUT"
		(exclude_from_sim no)
		(at 571.5 54.76 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left)
		)
		(uuid "fda8faaf-ca5a-5c2c-b516-3528c6a79889")
	)
	(text "EXPECT: +5 V from the USB-C (up to 2 A), -5 V at 40 mA, +15 V and -15 V at about 150 mA each for the pulse amplifier; green: 5 V in, red: -5 V up, yellow: +15 V up"
		(exclude_from_sim no)
		(at 408.94 268.94 0)
		(effects
			(font
				(size 1.2 1.2)
				(bold yes)
			)
			(justify left)
		)
		(uuid "fde2aa79-1c46-5e60-8d8f-b6f0ded911c4")
	)
